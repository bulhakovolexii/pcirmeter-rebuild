{
  "name": "Аналіз термограм",
  "short_name": "Термограми",
  "description": "Перегляд і аналіз радіометричних термограм PCIRMeter у браузері, без інтернету",
  "lang": "uk",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fcfcfc",
  "theme_color": "#2a2a2a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "image/jpeg": [".jpg", ".jpeg"], "application/octet-stream": [".hir"] }
    }
  ]
}
